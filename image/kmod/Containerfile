# Builds the out-of-tree DRBD 9 kmod against the newest CentOS Stream 10
# kernel and hands the matching kernel RPMs to the OS image. The appliance
# follows the latest kernel, not the base image's, and headers and kernel
# come out of one dnf resolution so they cannot diverge, nor depend on an
# older kernel still being in the repo. drbd-utils stay off the host: the
# r-drbd agent image carries its own, and the package's units would act
# on r-drbd's resources at shutdown.
FROM quay.io/centos/centos:stream10 AS build

# 9.3.x tracks current kernels; 9.2.x lacks the timer API of 6.16+.
ARG DRBD_VERSION=9.3.4

# dnf download skips signature checks; rpmkeys verifies the kernel RPMs
# against the CentOS key before they can reach the OS image.
RUN dnf install -y gcc make rpm-build elfutils-libelf-devel \
	kernel-devel kernel-rpm-macros dnf-plugins-core \
	&& kver=$(rpm -q --qf '%{VERSION}-%{RELEASE}' kernel-devel) \
	&& dnf download --destdir /out/kernel \
		kernel-$kver kernel-core-$kver kernel-modules-$kver \
		kernel-modules-core-$kver kernel-modules-extra-$kver \
	&& rpmkeys --import /etc/pki/rpm-gpg/RPM-GPG-KEY-centosofficial* \
	&& rpmkeys -K /out/kernel/*.rpm \
	&& dnf clean all

WORKDIR /build
RUN curl -fsSLO https://pkg.linbit.com/downloads/drbd/9/drbd-${DRBD_VERSION}.tar.gz

RUN tar xf drbd-${DRBD_VERSION}.tar.gz \
	&& make -C drbd-${DRBD_VERSION} kmp-rpm \
		KDIR=/usr/src/kernels/$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}' kernel-devel)

FROM scratch AS kmod
COPY --from=build /out/kernel /out/kernel
COPY --from=build /root/rpmbuild/RPMS /out/rpms
