# Builds the out-of-tree DRBD 9 kmod and drbd-utils as RPMs against the
# exact kernel of the microshift base image. The image build fails if the
# kernel headers and base kernel diverge; greenboot is the last resort,
# this stage is the first line.
FROM quay.io/centos/centos:stream10 AS build

# 9.3.x tracks current kernels; 9.2.x lacks the timer API of 6.16+.
# Piraeus's own module loaders ship the same line (drbd9 v9.3.3).
ARG DRBD_VERSION=9.3.3
ARG DRBD_UTILS_VERSION=9.34.0
# Must match the kernel in ghcr.io/epheo/microshift; CI extracts it from
# the base image and passes it in.
ARG KERNEL_VERSION

RUN dnf install -y gcc make rpm-build elfutils-libelf-devel \
	kernel-devel-${KERNEL_VERSION} kernel-rpm-macros \
	flex keyutils-libs-devel && dnf clean all

WORKDIR /build
RUN curl -fsSLO https://pkg.linbit.com/downloads/drbd/9/drbd-${DRBD_VERSION}.tar.gz \
	&& curl -fsSLO https://pkg.linbit.com/downloads/drbd/utils/drbd-utils-${DRBD_UTILS_VERSION}.tar.gz

RUN tar xf drbd-${DRBD_VERSION}.tar.gz \
	&& make -C drbd-${DRBD_VERSION} kmp-rpm KDIR=/usr/src/kernels/${KERNEL_VERSION}

# Utils ship as a plain DESTDIR tree, not an RPM: 9.31 dropped the rpm
# make target, and a bootc layer composes file trees anyway. drbdmon is
# the lone C++ piece; no manual keeps po4a, xsltproc, and the docbook
# network fetch out of the build.
# configure asks pkg-config for the systemd and udev directories and
# silently falls back to no unit dir and /lib/udev when the build image
# lacks systemd.pc and udev.pc, which it holds only by accident of
# dependency resolution. Every directory is pinned instead, and the tree
# is asserted to stay under etc/ and usr/: any other top-level entry is
# copied over a usr-merge symlink in the OS image and turns it into a
# directory, after which nss-altfiles (/lib/group) and the kmod tree
# (/lib/modules) are gone from the booted host.
RUN tar xf drbd-utils-${DRBD_UTILS_VERSION}.tar.gz \
	&& cd drbd-utils-${DRBD_UTILS_VERSION} \
	&& ./configure --prefix=/usr --localstatedir=/var --sysconfdir=/etc \
		--with-initscripttype=systemd \
		--with-systemdunitdir=/usr/lib/systemd/system \
		--with-systemdpresetdir=/usr/lib/systemd/system-preset \
		--with-systemd-exec-condition \
		--with-tmpfilesdir=/usr/lib/tmpfiles.d \
		--without-drbdmon --without-manual \
	&& make \
	&& make install DESTDIR=/out/utils udevrulesdir=/usr/lib/udev/rules.d \
	&& rm -rf /out/utils/var \
	&& [ "$(ls /out/utils | tr '\n' ' ')" = "etc usr " ]
# /out/utils/var holds only empty runtime dirs, and copying it into the OS
# image replaces the /var/run -> /run symlink with a real directory, which
# strands every pidfile written via the legacy path (ovsdb-server first).
# tmpfiles.d in the OS image recreates what drbd needs.

FROM scratch AS kmod
COPY --from=build /root/rpmbuild/RPMS /out/rpms
COPY --from=build /out/utils /out/utils
