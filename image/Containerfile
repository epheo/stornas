# stornas bootc layer on the epheo/microshift distro image.
# Pin by digest before release; :latest only while bootstrapping.
FROM ghcr.io/epheo/microshift:latest

# drbd-utils and the drbd9 kmod are not in CentOS repos; they come from
# the kmod build stage (image/kmod) matched to this image's kernel.
# Utils land as a file tree (no rpm target upstream); the kmod as RPMs.
COPY --from=kmod /out/rpms /tmp/drbd-rpms
COPY --from=kmod /out/utils/ /

RUN dnf install -y \
	lvm2 \
	mdadm \
	smartmontools \
	nvme-cli \
	targetcli \
	samba \
	nfs-utils \
	/tmp/drbd-rpms/*/kmod-drbd-[0-9]*.rpm \
	&& dnf clean all \
	&& rm -rf /tmp/drbd-rpms

# Everything the appliance runs ships in the image: workload images as OCI
# archives (imported into cri-o at boot by the distro's import service)
# and manifests applied from disk. No registry is reachable at runtime.
COPY build/embedded-images/ /usr/lib/embedded-images/
# The import service reads one manifest; merge our lines into the
# distro's (which keeps its own entries, e.g. portail).
RUN cat /usr/lib/embedded-images/manifest.stornas >> /usr/lib/embedded-images/manifest \
	&& rm /usr/lib/embedded-images/manifest.stornas
COPY manifests/piraeus/ /usr/lib/microshift/manifests.d/000-piraeus/
COPY manifests/stornas/ /usr/lib/microshift/manifests.d/010-stornas/

# LINSTOR CSI replaces the distro's TopoLVM (DESIGN.md): two default
# StorageClasses is a conflict, and two LVM managers must not share VGs.
# Erase the RPM, not just the manifests: it also ships a required greenboot
# check that would wait forever for TopoLVM and block boot-complete.target.
RUN rpm -e microshift-topolvm microshift-topolvm-release-info

# Greenboot gates on the stornas stack instead.
COPY files/50_stornas_storage_check.sh /etc/greenboot/check/required.d/

# The base image runs firewalld; without these ports the appliance
# cannot serve clients (UI NodePort, iSCSI, SMB, NFS).
COPY files/stornas.xml /etc/firewalld/services/
RUN firewall-offline-cmd --zone=public --add-service=stornas

# NAS plane: the agent rewrites only the stornas include; the base config
# stays image-owned. /var/lib/stornas is tmpfiles-created because bootc
# images do not ship /var content.
COPY files/smb.conf /etc/samba/smb.conf
RUN touch /etc/samba/stornas-shares.conf \
	&& printf '%s\n' \
		'd /var/lib/stornas 0755 root root -' \
		'd /var/lib/drbd 0755 root root -' \
		'd /run/drbd 0755 root root -' \
		'd /run/drbd/lock 0755 root root -' \
		> /usr/lib/tmpfiles.d/stornas.conf \
	&& systemctl enable smb nfs-server

# Storage kernel modules load at boot, not on demand: the satellite
# probes DRBD at startup and reports the layer unsupported if absent
# (the compile-on-node loader is removed for the air gap), and lvcreate
# runs inside the satellite container whose modprobe cannot see the
# host tree (dm-snapshot for LVM snapshots, dm-thin-pool for pools).
# usermode_helper=disabled is what the deleted loader would have set:
# SELinux confines kernel-spawned helpers (kernel_generic_helper_t
# cannot exec bash), each resync handler then exits 1 and DRBD drops
# the fresh connection; LINSTOR handles these events itself.
RUN printf '%s\n' drbd drbd_transport_tcp dm-snapshot dm-thin-pool \
		> /usr/lib/modules-load.d/stornas-storage.conf \
	&& echo 'options drbd usermode_helper=disabled' \
		> /usr/lib/modprobe.d/stornas-drbd.conf
